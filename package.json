  },
  "imports": {
    "#cds-models/*": "./@cds-models/*/index.js"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "model": [
          "db"
        ]
      }
    },
    "build": {
      "target": "gen"
    }
  },
  "workspaces": [
    "app/*"
  ]
